#include "resource.h"
#include <afxres.h>

IDR_MAINFRAME MENU
BEGIN
    POPUP "&File"
    BEGIN
        MENUITEM "&New\tCtrl+N", ID_FILE_NEW
        MENUITEM "&Open...\tCtrl+O", ID_FILE_OPEN
        MENUITEM "&Save\tCtrl+S", ID_FILE_SAVE
        MENUITEM "Save &As...", ID_FILE_SAVE_AS
        MENUITEM SEPARATOR
        MENUITEM "E&xit", ID_FILE_EXIT
    END
    POPUP "&Edit"
    BEGIN
        MENUITEM "&Undo\tCtrl+Z", ID_EDIT_UNDO
        MENUITEM "&Redo\tCtrl+Y", ID_EDIT_REDO
        MENUITEM SEPARATOR
        MENUITEM "Cu&t Clip\tCtrl+X", ID_EDIT_CUT_CLIP
        MENUITEM "&Copy Clip\tCtrl+C", ID_EDIT_COPY_CLIP
        MENUITEM "&Paste Clip\tCtrl+V", ID_EDIT_PASTE_CLIP
        MENUITEM "&Duplicate Clip\tCtrl+D", ID_EDIT_DUPLICATE_CLIP
        MENUITEM SEPARATOR
        MENUITEM "S&plit Clip\tCtrl+B", ID_EDIT_SPLIT_CLIP
    END
    POPUP "&Playback"
    BEGIN
        MENUITEM "&Play / Pause\tSpace", ID_PLAYBACK_TOGGLE
    END
END

IDR_MAINFRAME ACCELERATORS
BEGIN
    VK_SPACE, ID_PLAYBACK_TOGGLE, VIRTKEY
    "Z", ID_EDIT_UNDO, VIRTKEY, CONTROL
    "Y", ID_EDIT_REDO, VIRTKEY, CONTROL
    "X", ID_EDIT_CUT_CLIP, VIRTKEY, CONTROL
    "C", ID_EDIT_COPY_CLIP, VIRTKEY, CONTROL
    "V", ID_EDIT_PASTE_CLIP, VIRTKEY, CONTROL
    "D", ID_EDIT_DUPLICATE_CLIP, VIRTKEY, CONTROL
    "B", ID_EDIT_SPLIT_CLIP, VIRTKEY, CONTROL
    "N", ID_FILE_NEW, VIRTKEY, CONTROL
    "O", ID_FILE_OPEN, VIRTKEY, CONTROL
    "S", ID_FILE_SAVE, VIRTKEY, CONTROL
END
