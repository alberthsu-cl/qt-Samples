#include "resource.h"
#include <afxres.h>

IDR_MAINFRAME MENU
BEGIN
    POPUP "&Effects"
    BEGIN
        MENUITEM "&Settings...", ID_EFFECT_SETTINGS
    END
END

IDD_EFFECT_SETTINGS DIALOGEX 0, 0, 230, 88
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Effect Settings (MFC)"
FONT 9, "Segoe UI"
BEGIN
    LTEXT           "Effect:", -1, 12, 15, 50, 10
    COMBOBOX        IDC_EFFECT_COMBO, 68, 12, 146, 80, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    DEFPUSHBUTTON   "OK", IDOK, 104, 58, 50, 16
    PUSHBUTTON      "Cancel", IDCANCEL, 164, 58, 50, 16
END
